#: routes/admin/captive_portal.py
msgid "La URL pública debe ser una URL HTTP o HTTPS válida sin credenciales."
msgstr "Публичный URL должен быть действительным URL-адресом в формате HTTP или HTTPS без учетных данных."

#: routes/admin/captive_portal.py
msgid "El tiempo de vida de la sesión debe ser un entero positivo"
msgstr "Срок действия сеанса должен быть положительным целым числом"

#: routes/admin/captive_portal.py
msgid "La duración de la sesión debe ser un valor positivo y una unidad válida"
