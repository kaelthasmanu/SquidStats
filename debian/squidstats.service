[Unit]
Description=SquidStats – Squid Proxy Statistics Dashboard
Documentation=https://github.com/kaelthasmanu/SquidStats
After=network.target
Wants=network.target

[Service]
Type=simple
User=squidstats
Group=squidstats
WorkingDirectory=/opt/SquidStats/app
ExecStart=/opt/SquidStats/venv/bin/python3 /opt/SquidStats/app/app.py
Restart=on-failure
RestartSec=5

# Configuration file (generated by postinst from /opt/SquidStats/app/.env)
EnvironmentFile=/opt/SquidStats/app/.env

# Inherit squid log group so the service can read access logs
SupplementaryGroups=proxy

# Security hardening
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
CapabilityBoundingSet=

# /etc/squid may contain keytabs and other credentials.  This unit deliberately
# does not grant the web process a writable exception there.  The Kerberos UI
# remains preview/manual-only unless a deployment installs a separate,
# narrowly scoped and audited privileged write mechanism.
Environment=SQUIDSTATS_SQUID_CONFIG_WRITE_MODE=manual

# Resource limits
MemoryMax=2G
TimeoutStartSec=60
TimeoutStopSec=15

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=squidstats

[Install]
WantedBy=multi-user.target
